# =============================================================================
# Campus Harmony — Root Git Ignore
# =============================================================================

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java / Maven build artifacts
target/
backend/target/
*.class
*.jar
*.war
*.ear

# Frontend dependencies & build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.output/
frontend/.output/
.nitro/
frontend/.nitro/
.tanstack/
frontend/.tanstack/
.wrangler/
frontend/.wrangler/
.vinxi/
frontend/.vinxi/
*.local

# IDE & Editor Configuration
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.settings/
.project
.classpath
*.sublime-project
*.sublime-workspace
