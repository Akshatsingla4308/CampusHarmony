# =============================================================================
# Campus Harmony — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to '.env' and set your own secure passwords before launching.
# Mandatory: CAMPUS_DB_PASSWORD and CAMPUS_ADMIN_PASSWORD must be explicitly set.
# =============================================================================

# --- Runtime Mode ---
# Options: 'auto' (default: uses Docker if active and port 3306 is free, otherwise Native Windows),
#          'native' (uses local JDK, Maven, Node.js, and local MySQL Server),
#          'docker' (requires Docker Desktop running with port 3306 free)
CAMPUS_RUN_MODE=auto

# --- MySQL Database Configuration ---
CAMPUS_DB_USER=root
# REQUIRED: Set your local or container MySQL password (must not be empty)
CAMPUS_DB_PASSWORD=your_secure_mysql_password_here

# JDBC DataSource URL (used in Native mode; Docker Compose overrides the host to 'mysql')
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_harmony?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# --- First-Run Administrator Provisioning ---
# On the first boot against a newly initialized database, Spring Boot automatically
# provisions an administrator account with these credentials.
CAMPUS_ADMIN_LOGIN=admin
# REQUIRED: Set your initial administrator password (must not be empty)
CAMPUS_ADMIN_PASSWORD=your_secure_admin_password_here

# --- Frontend API Connectivity ---
# The backend REST API endpoint that the browser connects to
VITE_API_URL=http://localhost:8080/api
